# Installed to /etc/systemd/system/ by setup/bluetooth/install.sh.
# Re-applies the Bluetooth LE workarounds after every bluetoothd start.
# A separate unit rather than ExecStartPost: the controller only powers up
# after bluetooth.service is active, so waiting inside it deadlocks.
[Unit]
Description=SteamFrame Bluetooth LE workarounds (address resolution, privacy off)
After=bluetooth.service set-bluetooth-mac-address.service
PartOf=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/steamframe/bt-fixups.sh
TimeoutStartSec=5min

[Install]
WantedBy=bluetooth.service
