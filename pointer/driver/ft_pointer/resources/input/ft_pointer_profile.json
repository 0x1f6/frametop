		"/input/b": {
			"type": "button",
			"click": true
		},
		"/input/x": {
			"type": "button",
			"click": true
		},
		"/input/system": {
			"type": "button",
			"click": true
		},
		"/input/joystick": {
			"type": "joystick",
			"click": true
		},
		"/pose/raw": {
			"type": "pose"
		},
		"/pose/tip": {
			"type": "pose"
		},
		"/input/a": {
			"type": "button",
			"click": true
		}
	},
	"default_bindings": [
		{
			"app_key": "openvr.component.vrcompositor",
			"binding_url": "ft_pointer_vrcompositor.json"
