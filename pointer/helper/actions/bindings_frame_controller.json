{
  "action_manifest_version": 0,
  "controller_type": "frame_controller",
  "description": "Frametop: each button in an action set of its own, so only mapped ones are taken",
  "name": "Frametop pointer",
  "bindings": {
    "/actions/left_view": {
      "sources": [
        {
          "path": "/user/hand/left/input/view",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/left_view/in/press"
            }
          }
        }
      ]
    },
